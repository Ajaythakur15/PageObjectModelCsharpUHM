<Project Sdk="Microsoft.NET.Sdk">

	<!-- 🔧 Project Configuration -->
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsTestProject>true</IsTestProject>
		<!-- Prevent SDK from generating assembly attributes when duplicates exist -->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<!-- Prevent generation of TargetFrameworkAttribute to avoid duplicate attribute errors from SDK-generated files -->
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
	</PropertyGroup>

	<!-- 📦 NuGet Dependencies -->
	<ItemGroup>
		<!-- Reporting -->
		<PackageReference Include="ExtentReports" Version="5.0.2" />
		<!-- PackageReference Include="Allure.NUnit" Version="2.14.1"/>

		<!-- Testing Framework -->
		<!-- PackageReference Include="NUnit" Version="4.2.2" /-->
		<!-- PackageReference Include="NUnit3TestAdapter" Version="4.6.0" /-->
		<PackageReference Include="MSTest.TestFramework" Version="3.2.2" />
		<PackageReference Include="MSTest.TestAdapter" Version="3.2.2" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />

		<!-- Selenium & WebDriver -->
		<PackageReference Include="Selenium.WebDriver" Version="4.21.0" />
		<PackageReference Include="Selenium.Support" Version="4.21.0" />
		<PackageReference Include="DotNetSeleniumExtras.WaitHelpers" Version="3.11.0" />
		<PackageReference Include="WebDriverManager" Version="2.17.1" />

		<!-- Email Integration -->
		<PackageReference Include="SendGrid" Version="9.29.3" />
	</ItemGroup>

	<!-- 📁 Embedded Configuration -->
	<ItemGroup>
		<Content Include="config\App.properties">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>